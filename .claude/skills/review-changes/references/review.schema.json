{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Dev review: legacy and evidence v2",
  "oneOf": [
    {
      "$ref": "#/$defs/legacy"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "file",
        "line",
        "title",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "file": {
          "$ref": "#/$defs/text"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "body": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "relevant": {
      "properties": {
        "severity": {
          "enum": [
            "P1",
            "P2"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "base",
        "head",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/text"
        },
        "head": {
          "$ref": "#/$defs/text"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "cwd",
        "argv",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "$ref": "#/$defs/text"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "legacy": {
      "type": "object",
      "required": [
        "summary",
        "verdict",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/text"
        },
        "verdict": {
          "enum": [
            "approve",
            "request_changes"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "approve"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "not": {
                  "contains": {
                    "$ref": "#/$defs/relevant"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "v2": {
      "type": "object",
      "required": [
        "schema_version",
        "summary",
        "verdict",
        "findings",
        "scope",
        "checks",
        "limitations",
        "blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "verdict": {
          "enum": [
            "approve",
            "request_changes",
            "blocked"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "approve"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "findings": {
                    "not": {
                      "contains": {
                        "$ref": "#/$defs/relevant"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "blockers": {
                    "maxItems": 0
                  },
                  "checks": {
                    "items": {
                      "properties": {
                        "status": {
                          "const": "passed"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "request_changes"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "contains": {
                  "$ref": "#/$defs/relevant"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
